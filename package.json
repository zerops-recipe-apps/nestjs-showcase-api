{
  "name": "nestjs-showcase-api",
  "version": "1.0.0",
  "description": "NestJS API for the nestjs-showcase recipe on Zerops",
  "author": "Zerops",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zerops-recipe-apps/nestjs-showcase-api"
  },
  "homepage": "https://github.com/zerops-recipe-apps/nestjs-showcase-api",
  "bugs": {
    "url": "https://github.com/zerops-recipe-apps/nestjs-showcase-api/issues"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "migrate": "ts-node src/scripts/migrate.ts",
    "migrate:prod": "node dist/scripts/migrate.js",
    "seed": "ts-node src/scripts/seed.ts",
    "seed:prod": "node dist/scripts/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1103.0",
    "@aws-sdk/s3-request-presigner": "3.1103.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "ioredis": "5.9.3",
    "meilisearch": "0.60.0",
    "nats": "2.29.3",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3"
  },
  "keywords": [
    "nestjs",
    "zerops",
    "api",
    "postgresql",
    "nats"
  ],
  "overrides": {
    "es-toolkit": "1.51.0"
  }
}
